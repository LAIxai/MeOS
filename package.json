    "Brain Editor",
    "BiperLink",
    "Bi-Link",
    "markMup"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LAIxai/MeOS.git"
  },
  "homepage": "https://github.com/LAIxai/MeOS",
